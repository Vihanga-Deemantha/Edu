PORT=5067
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/edulink

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=10

# ── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
# Leave blank to use console-log fallback in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=EduHub <no-reply@eduhub.lk>

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Leave blank to use console-log fallback in development
SMS_PROVIDER=twilio
SMS_API_KEY=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER_ID=+1xxxxxxxxxx

# ── Google Sign-In ───────────────────────────────────────────────────────────
# Set GOOGLE_SIGNIN_ENABLED=true and add your Client ID to enable the /api/auth/google route.
# While false, the route is never registered and the app won't crash without a Client ID.
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
